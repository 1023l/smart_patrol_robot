<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inspect_navigation</name>
  <version>0.1.0</version>
  <description>
    工业巡检机器人导航系统集成包：Nav2 参数（梯度感知 A* 规划器 +
    KeepOutZone 禁区层 + TEB 控制器 + speed_limit 调速）、四级递进脱困
    行为树、多层厂房仿真地图与启动文件。
  </description>
  <maintainer email="dev@example.com">inspect navigation</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_gradient_planner</exec_depend>
  <exec_depend>nav2_keepout_layer</exec_depend>
  <exec_depend>inspect_speed_adapter</exec_depend>
  <exec_depend>inspect_floor_manager</exec_depend>
  <exec_depend>inspect_rl_avoidance</exec_depend>
  <exec_depend>inspect_interfaces</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
